# Application
APP_ENV=development
APP_NAME=AirIndex India
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://airindex:airindex@localhost:5432/airindex

# Redis
REDIS_URL=redis://localhost:6379/0

# Collection
COLLECTION_USER_AGENT=AirIndexIndiaResearchBot/0.1
COLLECTION_REQUEST_TIMEOUT_SECONDS=30
COLLECTION_MAX_CONCURRENCY=2

# Security
SECRET_KEY=replace-me
